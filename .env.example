# 本地开发模板。
#
# 部署到服务器时（compose 读取的 /opt/medical/backend.env）必须逐项确认：
#   APP_ENV=production           —— development 会放行「患者直接提交 openid 登录」的测试通道（见 router.go）；
#                                   反过来，设成 production 后 WECHAT_APPID/WECHAT_SECRET 缺失会直接启动失败
#   JWT_SECRET=<足够长的随机串>   —— 不要沿用本模板的空值、代码默认值或 change-this-to-a-long-random-secret
#   JWT_COOKIE_SECURE            —— 只有站点通过 HTTPS 访问时才设 true；站点是 IP+HTTP 时设 true，
#                                   浏览器会直接丢弃登录 Cookie，管理端登录彻底不可用
#   HTTP_PORT=9080               —— 必须与 deploy/Dockerfile 的 EXPOSE、deploy/docker-compose.yaml 的端口映射一致
#   MINIO_ENDPOINT               —— 不能填 localhost：容器里的 localhost 是容器自己，要填宿主/公网可达的地址
#   其余项（数据库、Redis、MinIO 凭据、微信与支付宝密钥等）按实际值填写

# Application
APP_ENV=development

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=9080

# Redis
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# 公开域目录缓存（科室/子科室/医生）：逻辑过期 + 异步重建，读缓存不可用时降级为直查数据库
PUBLIC_CATALOG_CACHE_ENABLED=true
PUBLIC_CATALOG_CACHE_TTL=30m
PUBLIC_CATALOG_CACHE_JITTER=0.2

# PostgreSQL
PGSQL_ADDR=localhost:5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=
PGSQL_DATABASE=postgres
PGSQL_SCHEMA=
# 连接池需显式限制总量并尽量保留空闲连接，避免公网高 RTT 下频繁建连放大尾延迟。
PGSQL_MAX_OPEN_CONNS=30
PGSQL_MAX_IDLE_CONNS=30
PGSQL_CONN_MAX_LIFETIME=30m
PGSQL_CONN_MAX_IDLE_TIME=5m

# Public doctor photo URL
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET=medical

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_COOKIE_SECURE=false

# 微信小程序登录（code2Session），生产环境必填
WECHAT_APPID=
WECHAT_SECRET=

# 支付宝当面付（alipay.trade.precreate / alipay.trade.query / 异步通知验签）
# 网关地址：生产 https://openapi.alipay.com/gateway.do
#           沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_SECRET=
ALIPAY_PUBLIC_SECRET=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_SUBJECT=医院挂号费
# 允许的 seller_id 集合（逗号分隔），留空表示不校验该项
ALIPAY_SELLER_IDS=
ALIPAY_HTTP_TIMEOUT=5s

# 支付宝异步通知地址：必须公网可达、HTTPS 且不带查询参数；
# 留空时不向 alipay.trade.precreate 传 notify_url，降级为主动查询模式
NOTIFY_URL=

# 公开域读缓存（T4b 排班缓存）
# 目录缓存（T4a）沿用独立的 PUBLIC_CATALOG_CACHE_* 前缀（见上方）：两套前缀暂时并存，
# 统一前缀会改动已部署环境的变量名，属于单独的改造任务，不在本次合并范围内
# 缓存是性能依赖而非正确性依赖：Redis 不可用时读路径一律降级直查数据库，不返回 5xx
CACHE_ENABLED=true
# 公开排班（含余量）缓存基准 TTL：缺省 8s；越界回落缺省值，
# 且按抖动比例反推上限，保证「基准 TTL ×(1+抖动)」不超过 10s
CACHE_SCHEDULE_TTL=8s
# TTL 抖动比例（±20%），避免同一时刻集体过期
CACHE_SCHEDULE_TTL_JITTER=0.2
# 单次缓存 Redis 操作超时：慢 Redis 不得把业务请求一起拖慢
CACHE_REDIS_TIMEOUT=100ms

# 订单过期收口任务（35 分钟收口与号源释放，spec/04-api-contract.md §6.8）
# 关闭后未付款订单会一直占用号源、判重也会拒绝重新挂号，仅在明确知道后果时才关闭
# 注意：ALIPAY_APP_ID / ALIPAY_APP_PRIVATE_SECRET 缺失时该任务同样不会启动
# （启动期配置错误下无法确认支付结果，不释放号源），启动日志会给出告警
ORDER_EXPIRY_WORKER_ENABLED=true
# 扫描间隔，规格建议 10~30 秒；进程启动时会先扫一轮，覆盖重启期间漏扫的订单
ORDER_EXPIRY_INTERVAL=20s
# 单轮扫描的订单上限
ORDER_EXPIRY_BATCH_SIZE=100
# 单笔订单调用 alipay.trade.query 的最大尝试次数；超过阈值仍失败时继续收口，保证号源释放
ORDER_EXPIRY_QUERY_ATTEMPTS=3
# 两次查询尝试之间的等待间隔
ORDER_EXPIRY_QUERY_RETRY_INTERVAL=500ms
# 单笔订单外部调用（查询 + 关单）的总时限；必须大于「查询尝试次数 × ALIPAY_HTTP_TIMEOUT + 重试等待」
# 并留出一次关单的余量，否则重试与关单会被掐掉
ORDER_EXPIRY_ORDER_TIMEOUT=30s

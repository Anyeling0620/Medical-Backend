
# Application
APP_NAME=medical-backend
APP_ENV=development

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Redis
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# HBase (Thrift)
HBASE_ADDR=localhost:9090

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=medical

# RocketMQ 5
ROCKETMQ_ENDPOINT=localhost:8081
ROCKETMQ_NAMESPACE=

# Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=medical-backend

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

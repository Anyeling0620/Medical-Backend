
# Application
APP_NAME=medical-backend
APP_ENV=development

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Redis
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL
PGSQL_ADDR=localhost:5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=
PGSQL_DATABASE=postgres

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=medical

# RocketMQ 5
ROCKETMQ_ENDPOINT=localhost:8081
ROCKETMQ_NAMESPACE=
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
ROCKETMQ_TOPIC=medical_events

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=medical-backend

# Logging
LOG_LEVEL=info
LOG_FORMAT=json


# Application
APP_ENV=development

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Redis
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL
PGSQL_ADDR=localhost:5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=
PGSQL_DATABASE=postgres
PGSQL_SCHEMA=

# Public doctor photo URL
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET=medical

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_COOKIE_SECURE=false

# 微信小程序登录（code2Session），生产环境必填
WECHAT_APPID=
WECHAT_SECRET=

# 支付宝当面付（alipay.trade.precreate / alipay.trade.query / 异步通知验签）
# 网关地址：生产 https://openapi.alipay.com/gateway.do
#           沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_SECRET=
ALIPAY_PUBLIC_SECRET=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_SUBJECT=医院挂号费
# 允许的 seller_id 集合（逗号分隔），留空表示不校验该项
ALIPAY_SELLER_IDS=
ALIPAY_HTTP_TIMEOUT=5s

# 支付宝异步通知地址：必须公网可达、HTTPS 且不带查询参数；
# 留空时不向 alipay.trade.precreate 传 notify_url，降级为主动查询模式
NOTIFY_URL=
